# Скопируйте как config.env. Не публикуйте файл с секретами.
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=0
# PUBLIC_ORIGIN=https://finance.your-domain.uz
# DATABASE_URL=postgresql+psycopg://cashflow:YOUR_PASSWORD@127.0.0.1:5432/cashflow
# PG_BACKUP_BIN=C:/Tools/PostgreSQL/18/bin
# Separate backup client; do not replace PG_BIN used by the local server.
# FINMODEL_PATH=C:/Users/YourName/My Drive/FinModel 2026 Zuma_Pharm v8.xlsx
# GOOGLE_APPLICATION_CREDENTIALS=C:/Zuma_CashFlow/secrets/drive.json
# GOOGLE_DRIVE_FILE_ID=1XCZbSDWBLjf-X5lqvBaLQhvb3R0eRSRr
# Telegram-бот (Cash_Zuma_Bot). Без BOT_CLIENT_ID и BOT_CLIENT_SECRET API бота отвечает 503.
# Секрет — не короче 32 случайных символов; в боте тот же секрет в CASH_ZUMA_BOT_CLIENT_SECRET.
# BOT_CLIENT_ID=cash-zuma-bot
# BOT_CLIENT_SECRET=
# Группы для утренней сводки: ID группы и коды компаний; несколько групп через «;».
# BOT_REPORT_GROUPS=-1001234567890:UZGERMED,ZUMA
# Имя бота без @ — для кнопки «Открыть бота» в профиле.
# TELEGRAM_BOT_USERNAME=ZumaPharm_Cashbot

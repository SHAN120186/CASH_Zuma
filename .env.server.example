# Копировать в .env только на сервере. Не загружать в публичный репозиторий.
DOMAIN=cashflow.example.com
ACME_EMAIL=admin@example.com
# Заменить на случайный hex-пароль, например: python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
JWT_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Optional integrations. Store actual credentials only on the server.
GOOGLE_SHEETS_TRANSACTIONS_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS_MODE=starttls
